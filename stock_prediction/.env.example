# API Keys (tentukan kemudian)
STOCK_API_KEY=
NEWS_API_KEY=

# Model Config
LSTM_MODEL_PATH=data/artifacts/lstm_weights/lstm_model.h5
FINBERT_MODEL_NAME=ProsusAI/finbert
FINBERT_DEVICE=-1

# Data Paths
RAW_NEWS_CSV=data/raw/news/sp500_headlines_2008_2024.csv
SENTIMENT_PROCESSED_DIR=data/processed/sentiment

# Rentang data yang dipakai preprocessing/training — mengontrol DUA sumber
# sekaligus supaya tetap sinkron: data/{raw,processed}/stocks/GSPC_<range>.csv
# (OHLCV) DAN data/raw/news/sp500_headlines_<range>.csv (headline berita).
# Pilihan: 2018_2024 (default, ~6 tahun) atau 2008_2024 (~16 tahun, mencakup GFC 2008 & COVID 2020)
STOCK_DATA_RANGE=2018_2024

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true
